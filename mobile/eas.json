{
  "cli": {
    "version": ">= 5.9.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "development",
        "EXPO_PUBLIC_API_URL": "https://flow-api.example.com"
      }
    },
    "production": {
      "distribution": "internal",
      "environment": "production",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://flow-api.andradesystems.com.br",
        "EXPO_PUBLIC_ONESIGNAL_APP_ID": "ff867788-a559-4e80-b92d-14b9d29026ea",
        "EAS_PROJECT_ID": "6e9e4f64-2c3d-454a-963b-7d4fea58ab4b"
      }
    },
    "production-store": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://flow-api.example.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
