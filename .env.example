# ==============================================================================
# Configurações de Ambiente - Flow API
# Copie este ficheiro, renomeie para ".env" e preencha os valores abaixo.
# NUNCA faça commit do ficheiro ".env" no repositório.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações Básicas [ OBRIGATÓRIO ]
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
MONGO_DATABASE=flow

# ------------------------------------------------------------------------------
# 2. Autenticação (JWT) [ OBRIGATÓRIO ]
# ------------------------------------------------------------------------------
# Chave secreta para assinatura dos tokens. Deve ter pelo menos 32 caracteres.
# Como obter/gerar: Execute `openssl rand -base64 48` no terminal ou crie uma palavra-passe longa e segura.
JWT_SECRET_KEY=
JWT_ISSUER=FlowAPI
JWT_AUDIENCE=FlowApp
JWT_EXPIRY_MINUTES=15
REFRESH_TOKEN_DAYS=7

# ------------------------------------------------------------------------------
# 3. Inteligência Artificial (Google Gemini) [ OBRIGATÓRIO PARA A AVALIAÇÃO ]
# ------------------------------------------------------------------------------
# Essencial para os recursos de IA (priorização de ideias e insights).
# Onde obter: Aceda a https://aistudio.google.com/app/apikey, faça login com a conta Google e clique em "Create API key".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# 4. Notificações Push (OneSignal) [ OPCIONAL ]
# ------------------------------------------------------------------------------
# Se deixado em branco, o funcionamento interno da app mantém-se, mas as notificações push não são enviadas.
# Onde obter: No painel de controle do OneSignal (Settings > Keys & IDs).
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# ------------------------------------------------------------------------------
# 5. Dados de Demonstração (Seeding) [ RECOMENDADO PARA A APRESENTAÇÃO ]
# ------------------------------------------------------------------------------
# Mude para "true" para popular a base de dados com informações falsas (projetos, ideias, utilizadores) e facilitar a demonstração.
# Defina uma palavra-passe padrão que será aplicada aos utilizadores de teste gerados.
SEED_DEMO_DATA=false
SEED_DEMO_PASSWORD=

# ------------------------------------------------------------------------------
# 6. Configurações Avançadas e Infraestrutura [ OPCIONAL ]
# ------------------------------------------------------------------------------
SWAGGER_ENABLED=true
# Origens permitidas para CORS (deixe em branco se apenas a app mobile consumir a API).
CORS_ALLOWED_ORIGINS=

# Configurações de Proxy Reverso (Ative apenas se utilizar Traefik/Nginx à frente da API no servidor)
FORWARDED_HEADERS_ENABLED=false
FORWARDED_TRUSTED_NETWORKS=
FORWARDED_TRUSTED_PROXIES=
FORWARDED_LIMIT=1

# Observabilidade (OpenTelemetry)
OTLP_ENDPOINT=

# ==============================================================================
# Variáveis do Aplicativo Mobile (Configurar no ficheiro mobile/.env)
# ==============================================================================
# EXPO_PUBLIC_ENV=local
# EXPO_PUBLIC_API_URL=http://SEU_IP_LOCAL_DA_REDE:5000
# EXPO_PUBLIC_ONESIGNAL_APP_ID=