{
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017/?replicaSet=rs0",
    "Database": "flow",
    "EnsureIndexes": true
  },
  "JwtSettings": {
    "SecretKey": "CHANGE-THIS-IN-PRODUCTION-must-be-at-least-32-chars",
    "Issuer": "FlowAPI",
    "Audience": "FlowApp",
    "ExpiryMinutes": "15"
  },
  "Auth": {
    "RefreshTokenDays": 7
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "Swagger": {
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Gemini": {
    "ApiKey": "",
    "Model": "gemini-3.8-flash",
    "Timeout": "00:00:30",
    "Temperature": 0.2,
    "MaxOutputTokens": 4096,
    "CircuitBreakerFailureThreshold": 5,
    "CircuitBreakerCooldown": "00:01:00"
  },
  "OneSignal": {
    "AppId": "",
    "ApiKey": "",
    "BaseUrl": "https://api.onesignal.com/",
    "Timeout": "00:00:10"
  },
  "Outbox": {
    "Enabled": true,
    "BatchSize": 50,
    "MaxAttempts": 6,
    "PollInterval": "00:00:15",
    "StartupDelay": "00:00:05"
  },
  "DemoSeed": {
    "OperatorEmail": "operator@flow.demo",
    "ManagerEmail": "manager@flow.demo",
    "LeadershipEmail": "leadership@flow.demo",
    "Password": ""
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "TrustedProxies": [],
    "TrustedNetworks": [],
    "ForwardLimit": 1,
    "TrustForwardedHost": false
  },
  "RateLimiting": {
    "Enabled": true,
    "AuthPermitPerMinute": 10,
    "AiPermitPerFiveMinutes": 20,
    "GlobalPermitPerMinute": 300
  }
}
